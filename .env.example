# Supabase Configuration for IUOVA Cashflow
# Replace with your Supabase project URL and anon public key:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only secret for the loopback-only Vite proxy. Never prefix with VITE_.
FSS_EDGE_ACCESS_TOKEN=generate-a-random-64-character-hex-token
